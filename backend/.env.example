# StatSkill AI Backend Environment Variables
PORT=5000

# PostgreSQL Connection (Optional: Falls back to local JSON matrix automatically if DB is offline)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/statskill?schema=public"

# Authentication
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production

# AI Cloud RAG Keys (Optional: Falls back to local 200+ question bank automatically if keys not provided)
GEMINI_API_KEY=
GROQ_API_KEY=

# National iGOT Karmayogi LRS Telemetry Endpoint (Optional: Logs store-and-forward xAPI statements locally if unset)
IGOT_LRS_ENDPOINT=
